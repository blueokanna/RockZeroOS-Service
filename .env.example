# RockZero Server Configuration
# Copy this file to .env and modify as needed

# Server binding
HOST=0.0.0.0
PORT=8080

# Database
DATABASE_URL=sqlite://rockzero.db

# JWT Authentication
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-characters-long
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=30

# Data Encryption
ENCRYPTION_KEY=change-this-32-character-key!!

# TLS Configuration (optional)
TLS_ENABLED=false
TLS_CERT_PATH=./certs/cert.pem
TLS_KEY_PATH=./certs/key.pem

# Storage Management
# 外部存储路径（用于视频和大文件）
EXTERNAL_STORAGE_PATH=/mnt/external
VIDEO_STORAGE_PATH=/mnt/external/videos
TEMP_STORAGE_PATH=/mnt/external/temp

# HLS 缓存路径
HLS_CACHE_PATH=./data/hls_cache

# 日志路径
LOG_PATH=./data/logs

# 存储空间管理
MIN_FREE_SPACE=1073741824  # 最小可用空间（字节），默认 1GB
HLS_CACHE_RETENTION_DAYS=7  # HLS 缓存保留天数
TEMP_FILE_RETENTION_DAYS=1  # 临时文件保留天数
LOG_RETENTION_DAYS=30  # 日志文件保留天数

# Secure Storage
SECURE_STORAGE_PATH=./data/secure_storage

# Data Directory
DATA_DIR=./data

# FFmpeg Configuration
# FFmpeg assets 目录（包含静态编译的 FFmpeg 压缩包）
FFMPEG_ASSETS_PATH=./assets
# 可选：直接指定 FFmpeg 压缩包路径
# FFMPEG_ARCHIVE_PATH=./assets/ffmpeg-release-arm64-static.tar.xz
# 可选：直接指定 FFmpeg 可执行文件路径（如果已解压）
# FFMPEG_PATH=./data/ffmpeg/ffmpeg
# FFPROBE_PATH=./data/ffmpeg/ffprobe

# Logging
RUST_LOG=info

# ==============================
# WangXinYun (WXY) Edge Adapter
# ==============================
# 开启后未登录网心云时禁止提交边缘任务
EDGE_REQUIRE_WXY_AUTH=true
# 边缘计算状态持久化目录
EDGE_COMPUTE_ROOT=./data/edge
# 队列与历史上限，防止内存/磁盘无限增长
EDGE_MAX_PENDING_JOBS=256
EDGE_MAX_TOTAL_JOBS=5000
# 单个 WASM 和执行输出大小限制（字节）
EDGE_WASM_MAX_BYTES=67108864
EDGE_JOB_STDIO_MAX_BYTES=1048576

# 网心云网关与客户端参数（替换为真实值）
# 示例: https://api.wxy.example.com
WXY_API_BASE=
WXY_CLIENT_ID=

# 扫码登录启动接口
WXY_QR_START_PATH=/auth/qr/start
WXY_QR_START_METHOD=POST
# 可选附加 JSON（会并入请求体）
# WXY_QR_START_EXTRA_JSON={"app_id":"your_app_id"}

# 扫码轮询接口
WXY_QR_POLL_PATH=/auth/qr/poll/{session_id}
WXY_QR_POLL_METHOD=GET
# 可选附加 JSON（POST 时并入请求体）
# WXY_QR_POLL_EXTRA_JSON={"tenant":"prod"}

# 令牌自动刷新
WXY_AUTO_REFRESH_ENABLED=true
WXY_AUTO_REFRESH_INTERVAL_SECS=60
WXY_REFRESH_AHEAD_SECS=300
WXY_REFRESH_FAIL_GRACE_SECS=300
WXY_TOKEN_REFRESH_PATH=/auth/token/refresh
WXY_TOKEN_REFRESH_METHOD=POST
WXY_TOKEN_REFRESH_TIMEOUT_SECS=20
# WXY_TOKEN_REFRESH_EXTRA_JSON={"grant_type":"refresh_token"}

# 启动/周期自检（秒）。0 表示仅启动时检查一次，不做周期检查
EDGE_SELF_CHECK_INTERVAL_SECS=0
WXY_GATEWAY_HEALTH_PATH=/
WXY_GATEWAY_HEALTH_METHOD=GET
WXY_GATEWAY_HEALTH_TIMEOUT_SECS=8

# 可选：用于字段映射自检的真实样例 JSON（建议粘贴脱敏样例）
# WXY_SELF_CHECK_START_SAMPLE_JSON={"data":{"qr_url":"https://...","session_id":"abc"}}
# WXY_SELF_CHECK_POLL_SAMPLE_JSON={"data":{"status":"confirmed","access_token":"token"}}

# ===== 协议字段适配（可按真实返回一比一调整） =====
# 多路径按逗号分隔，支持点路径或 JSON Pointer（/data/token）
WXY_ADAPTER_QR_URL_PATHS=qr_url,qrcode_url,data.qr_url,data.qrcode_url,data.url,result.qr_url
WXY_ADAPTER_SESSION_ID_PATHS=session_id,sid,data.session_id,result.session_id
WXY_ADAPTER_DEVICE_CODE_PATHS=device_code,data.device_code,result.device_code
WXY_ADAPTER_STATUS_PATHS=status,data.status,result.status,code,data.code

WXY_ADAPTER_ACCESS_TOKEN_PATHS=access_token,data.access_token,result.access_token,data.token,result.token
WXY_ADAPTER_REFRESH_TOKEN_PATHS=refresh_token,data.refresh_token,result.refresh_token
WXY_ADAPTER_ACCOUNT_ID_PATHS=account_id,data.account_id,result.account_id,data.user_id,result.user_id,data.uid
WXY_ADAPTER_EXPIRES_AT_PATHS=expires_at,data.expires_at,result.expires_at
WXY_ADAPTER_EXPIRES_IN_PATHS=expires_in,data.expires_in,result.expires_in

# 状态文本映射（contains 匹配）
WXY_ADAPTER_STATUS_CONFIRMED=confirm,success,authorized,ok,done
WXY_ADAPTER_STATUS_SCANNED=scan,scanned
WXY_ADAPTER_STATUS_EXPIRED=expire,expired,timeout,timed_out
WXY_ADAPTER_STATUS_FAILED=fail,failed,deny,reject,cancel,cancelled,error

# Command line usage:
# rockzero --port 8080 --host 0.0.0.0
# rockzero -p 8080 -h 0.0.0.0
